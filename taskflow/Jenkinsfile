pipeline {
    agent any

    environment {
        APP_NAME = 'taskflow'
        IMAGE_NAME = 'taskflow'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        HELM_RELEASE = 'taskflow'
        K8S_NAMESPACE = 'taskflow'
        KIND_CLUSTER_NAME = 'kind'
        PYTHON_CMD = 'py -3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('taskflow') {
                    bat 'py -3 -m pip install --upgrade pip'
                    bat 'py -3 -m pip install -r requirements.txt'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('taskflow') {
                    bat 'py -3 -m pytest -q'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('taskflow') {
                    bat "docker build -t %IMAGE_NAME%:%IMAGE_TAG% ."
                }
            }
        }

        stage('Lint Helm Chart') {
            steps {
                bat 'helm lint taskflow\\helm\\taskflow'
                bat 'helm template %HELM_RELEASE% taskflow\\helm\\taskflow > NUL'
            }
        }

        stage('Prepare Kind Cluster') {
            steps {
                bat """
                    kind get clusters 2>NUL | findstr /C:"%KIND_CLUSTER_NAME%" >NUL
                    if errorlevel 1 (
                        kind create cluster --name %KIND_CLUSTER_NAME%
                    )
                    kind load docker-image %IMAGE_NAME%:%IMAGE_TAG% --name %KIND_CLUSTER_NAME%
                """
            }
        }

        stage('Deploy to Kind') {
            steps {
                bat """
                    kubectl create namespace %K8S_NAMESPACE% --dry-run=client -o yaml | kubectl apply -f -
                    helm upgrade --install %HELM_RELEASE% taskflow\\helm\\taskflow --namespace %K8S_NAMESPACE% --create-namespace --set image.repository=%IMAGE_NAME% --set image.tag=%IMAGE_TAG% --set app.name=%APP_NAME%
                """
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl rollout status deployment/%HELM_RELEASE% -n %K8S_NAMESPACE% --timeout=180s'
                bat 'kubectl get pods -n %K8S_NAMESPACE%'
                bat 'kubectl get svc -n %K8S_NAMESPACE%'
            }
        }
    }
}
